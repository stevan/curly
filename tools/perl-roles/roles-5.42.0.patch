+    /* Walk superclass chain */
+    while (super) {
+        HE *he = hv_fetch_ent(super, name, 0, 0);
+        if (he) {
+            SV *entry = HeVAL(he);
+            CV *cv = NULL;
+            if (SvTYPE(entry) == SVt_PVGV && isGV_with_GP(entry))
+                cv = GvCV((GV *)entry);
+            else if (SvROK(entry) && SvTYPE(SvRV(entry)) == SVt_PVCV)
+                cv = (CV *)SvRV(entry);
+            if (cv && CvROOT(cv))
