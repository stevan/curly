+/* Check if the class inherits a method from its superclass chain */
+static bool
+S_class_inherits_method(pTHX_ HV *stash, SV *name)
+{
+    struct xpvhv_aux *aux = HvAUX(stash);
+    HV *super = aux->xhv_class_superclass;
